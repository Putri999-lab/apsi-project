# Copy to the workspace root as .env and fill in private values.
# Local Node/Next.js and Prisma CLI use the Docker-exposed host connection.
DATABASE_URL="postgresql://postgres:URL_ENCODED_PASSWORD@localhost:5432/apsi_db?schema=public"
DIRECT_URL="postgresql://postgres:URL_ENCODED_PASSWORD@localhost:5432/apsi_db?schema=public"
# Docker Compose app uses the service DNS name rather than localhost.
DOCKER_DATABASE_URL="postgresql://postgres:URL_ENCODED_PASSWORD@db:5432/apsi_db?schema=public"

# For Neon deployments, DATABASE_URL is the pooled URL; DIRECT_URL is direct.
# AUTH_SECRET must contain at least 32 random bytes.
AUTH_SECRET="replace-with-a-random-secret-at-least-32-bytes-long"

# Required only for registration of these privileged roles.
EMPLOYEE_REGISTRATION_CODE=""
OWNER_REGISTRATION_CODE=""
ADMIN_REGISTRATION_CODE=""

# Optional persistent directory for uploaded payment proofs.
PAYMENT_PROOF_DIR="./.uploads/payment-proofs"

# Local Docker database credentials. Keep POSTGRES_PASSWORD private.
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="replace-with-a-private-password"
POSTGRES_DB="apsi_db"
